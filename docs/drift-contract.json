{
  "schemaVersion": 1,
  "contracts": [
    {
      "id": "ci-recovery",
      "source": ".github/workflows/ci-recovery.yml",
      "documentation": "docs/architecture.md",
      "sourceTerms": ["run_attempt == 1", "rerun-failed-jobs", "Record human handoff", "ci-recovery-decision.json"],
      "documentationTerms": [
        "applies one flaky-infrastructure rerun only for a known transient signal",
        "hands deterministic, unknown, or unavailable-log failures to humans",
        "code from the failed ref"
      ]
    },
    {
      "id": "self-healing-policy",
      "source": ".github/self-healing.json",
      "documentation": "docs/architecture.md",
      "sourceTerms": [
        "\"mode\": \"containment\"",
        "\"signal\": \"flaky-infrastructure-rerun\"",
        "\"maxAttempts\": 1",
        "\"terminalAction\": \"human_handoff\""
      ],
      "documentationTerms": [
        "applies one flaky-infrastructure rerun only for a known transient signal",
        "terminal outcome",
        "hands deterministic, unknown, or unavailable-log failures to humans"
      ]
    },
    {
      "id": "agent-findings-audit",
      "source": ".github/workflows/agent-findings-audit.md",
      "documentation": "docs/architecture.md",
      "sourceTerms": ["bash: false", "cli-proxy: false", "max-turns: 40", "submit-findings-audit-report"],
      "documentationTerms": [
        "manually triggered GitHub Agentic Workflow",
        "bounded turns and AI credits",
        "read-only repository permissions"
      ]
    },
    {
      "id": "active-branch-policy",
      "source": ".github/branch-protection.yml",
      "documentation": "CONTRIBUTING.md",
      "sourceTerms": [
        "enforcement: active",
        "rulesetId: 23527101",
        "codeOwnerReview: true",
        "minimumApprovals: 1",
        "- application",
        "- remediation-proof / remediation-proof"
      ],
      "documentationTerms": ["active default-branch contract", "Ruleset `23527101`", "no configured actor can bypass"]
    },
    {
      "id": "agent-repair-proposal",
      "source": ".github/workflows/agent-repair-proposal.yml",
      "documentation": "docs/architecture.md",
      "sourceTerms": [
        "permissions:",
        "contents: read",
        "--available-tools view rg glob edit",
        "agent-repair-contract.mjs finalize",
        "Upload validated repair proposal",
        "Exhaust agent repair workspace and credentials",
        "if: always()"
      ],
      "documentationTerms": [
        "explicit allowlist of existing files",
        "no repository write permission",
        "requires human review and manual application",
        "exhausts both checkouts"
      ]
    },
    {
      "id": "copilot-code-review-policy",
      "source": ".github/copilot-code-review.yml",
      "documentation": "docs/architecture.md",
      "sourceTerms": [
        "\"mode\": \"read-only\"",
        "\"copilotCliVersion\": \"1.0.83\"",
        "\"maxAiCredits\": 30",
        "\"allowedTools\": [\"view\", \"rg\", \"glob\"]"
      ],
      "documentationTerms": ["pins the model, CLI, AI credit limit", "read-only tool set", "review inputs", "digest"]
    },
    {
      "id": "agent-improvement-lifecycle",
      "source": "docs/agent-findings/learned-rules.json",
      "documentation": "docs/agent-findings/README.md",
      "sourceTerms": [
        "\"kind\": \"esp-agent-learned-rules\"",
        "\"status\": \"active\"",
        "\"sourceFindingIds\"",
        "\"lastVerifiedAt\""
      ],
      "documentationTerms": [
        "governed learned-rule corpus",
        "existing regression-test paths",
        "Retirement records",
        "feedback loop"
      ]
    },
    {
      "id": "governance-mcp-server",
      "source": "scripts/esp-governance-mcp.mjs",
      "documentation": "docs/architecture.md",
      "sourceTerms": ["esp_governance_snapshot", "esp_validation_plan", "readOnlyHint: true", "inputSchema: {}"],
      "documentationTerms": [
        "ESP governance MCP server",
        "fixed empty inputs",
        "no shell, network",
        "mutation capability"
      ]
    },
    {
      "id": "release-rollback",
      "source": ".github/workflows/release.yml",
      "documentation": "docs/architecture.md",
      "sourceTerms": ["redeploy-last-good", "deploy-release.mjs --mode execute", "ESP_BASELINE_RUN_ID"],
      "documentationTerms": ["redeploy-last-good", "deployWithRollback", "provenance-bound running baseline"]
    },
    {
      "id": "closed-loop-remediation-outcomes",
      "source": "dashboards/closed-loop-remediation-outcomes.json",
      "documentation": "docs/architecture.md",
      "sourceTerms": [
        "\"automatedRollback\": true",
        "\"distinctFailureClassCount\": 2",
        "\"verifiedClosedLoopCount\": 2",
        "\"verifiedOutcome\": \"rollback.verified\""
      ],
      "documentationTerms": ["closed-loop remediation dashboard", "two synthetic failure classes", "verify rollback"]
    },
    {
      "id": "closed-loop-remediation-proof-workflow",
      "source": ".github/workflows/closed-loop-remediation-proof.yml",
      "documentation": "docs/architecture.md",
      "sourceTerms": [
        "workflow_call:",
        "npm run remediation:check",
        "Upload verified closed-loop remediation outcomes",
        "if-no-files-found: error"
      ],
      "documentationTerms": [
        "Closed-loop Remediation Proof",
        "uploads the validated",
        "ruleset directly requires the proof job",
        "proof job succeeds"
      ]
    },
    {
      "id": "agent-exception-lifecycle",
      "source": ".github/workflows/agent-exception-audit.yml",
      "documentation": "docs/architecture.md",
      "sourceTerms": [
        "schedule:",
        "issues: read",
        "validate-agent-exception-lifecycle.mjs",
        "audit-agent-exceptions.mjs",
        "Upload machine-readable exception audit",
        "if-no-files-found: error"
      ],
      "documentationTerms": [
        "Agent Exception Audit",
        "closed-loop exception lifecycle proof",
        "pending, active, expired, or malformed",
        "mutationAllowed: false",
        "fail closed"
      ]
    },
    {
      "id": "agent-review-exhaust-cleanup",
      "source": ".github/workflows/agent-review.yml",
      "documentation": "docs/architecture.md",
      "sourceTerms": [
        "Upload validated review artifact",
        "Exhaust agent review workspace and credentials",
        "if: always()",
        "$RUNNER_TEMP/copilot-events.jsonl"
      ],
      "documentationTerms": ["exhausts the trusted and target checkouts", "after artifact upload"]
    }
  ]
}
